{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ungaaaabungaaa/Relay/blob/main/release/release-manifest.schema.json",
  "title": "Relay signed release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "tag",
        "version",
        "license",
        "mac",
        "codex",
        "artifacts"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "license": { "const": "Apache-2.0" },
        "mac": { "$ref": "#/$defs/mac" },
        "codex": { "$ref": "#/$defs/codex" },
        "artifacts": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["name", "architecture", "signed"],
                "properties": {
                  "name": { "const": "Relay.dmg" },
                  "architecture": { "const": "arm64" },
                  "signed": { "const": true }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["name", "architecture", "signed"],
                "properties": {
                  "name": {
                    "pattern": "^Relay-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\.tar\\.gz$"
                  },
                  "architecture": { "const": "source" },
                  "signed": { "const": false }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["name", "architecture", "signed"],
                "properties": {
                  "name": { "const": "LICENSE" },
                  "architecture": { "const": "text" },
                  "signed": { "const": false }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["name", "architecture", "signed"],
                "properties": {
                  "name": { "const": "NOTICE" },
                  "architecture": { "const": "text" },
                  "signed": { "const": false }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["name", "architecture", "signed"],
                "properties": {
                  "name": { "const": "THIRD_PARTY_NOTICES.md" },
                  "architecture": { "const": "text" },
                  "signed": { "const": false }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["name", "architecture", "signed"],
                "properties": {
                  "name": { "const": "COMPATIBILITY.md" },
                  "architecture": { "const": "text" },
                  "signed": { "const": false }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64"
    }
  },
  "$defs": {
    "mac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact", "architecture"],
      "properties": {
        "version": { "type": "string" },
        "artifact": { "const": "Relay.dmg" },
        "architecture": { "const": "arm64" }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion", "maximumVersion"],
      "properties": {
        "minimumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.(?:[0-9]+|x)$" },
        "maximumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.(?:[0-9]+|x)$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "architecture",
        "sha256",
        "signed"
      ],
      "properties": {
        "name": {
          "oneOf": [
            { "const": "Relay.dmg" },
            {
              "type": "string",
              "pattern": "^Relay-[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\.tar\\.gz$"
            },
            { "const": "LICENSE" },
            { "const": "NOTICE" },
            { "const": "THIRD_PARTY_NOTICES.md" },
            { "const": "COMPATIBILITY.md" }
          ]
        },
        "version": { "type": "string" },
        "architecture": {
          "enum": ["arm64", "source", "text"]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signed": { "type": "boolean" }
      }
    }
  }
}
