{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_TUNNEL",
        "class_name": "AccountTunnel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountTunnel"]
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://relayforcodex.com",
    "RESEND_FROM": "Relay <sign-in@relayforcodex.com>"
  }
}
